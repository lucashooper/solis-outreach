# Product name used when a campaign has none.
APP_NAME=
# One-line pitch used when a campaign has none.
APP_VALUE_PROP=

# Supabase project URL. Required to boot. Not stored in Settings.
SUPABASE_URL=
# Service role key. Server only. Never put this in the admin build.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key. Also set as VITE_SUPABASE_ANON_KEY for the admin.
SUPABASE_ANON_KEY=

# Shared secret for inbound webhooks. Same value in the sender and the API.
WEBHOOK_SHARED_SECRET=

# Groq API key for personalisation and reply classification.
GROQ_API_KEY=
# Optional model. Defaults to openai/gpt-oss-120b.
LLM_MODEL=
# Optional OpenAI-compatible base URL. Defaults to Groq.
LLM_BASE_URL=
# Optional smaller model for video hooks.
LLM_HOOK_MODEL=

# Resend API key for outbound email.
RESEND_API_KEY=
# Verified from address. May include a display name: Name <you@example.com>.
RESEND_FROM_EMAIL=
# Optional display name when the from address has no angle brackets.
RESEND_FROM_NAME=
# Mailbox that receives replies.
RESEND_REPLY_TO=

# Google OAuth client for Gmail reply sync.
GMAIL_CLIENT_ID=
# Google OAuth client secret.
GMAIL_CLIENT_SECRET=
# Optional refresh token. Connectors stores one after you connect Gmail.
GMAIL_REFRESH_TOKEN=
# Optional Gmail address used as the Connect login hint.
GMAIL_MAILBOX=

# Optional Instantly provider key.
INSTANTLY_API_KEY=
# Optional Instantly campaign id.
INSTANTLY_CAMPAIGN_ID=
# Optional Smartlead provider key.
SMARTLEAD_API_KEY=
# Optional Smartlead campaign id.
SMARTLEAD_CAMPAIGN_ID=

# Optional Slack incoming webhook.
SLACK_WEBHOOK_URL=
# Optional Discord webhook. Connectors can store this too.
DISCORD_WEBHOOK_URL=

# Public admin origin used in alert links.
ADMIN_BASE_URL=
# Public API origin used for the Gmail callback. Example: https://api.example.com
PUBLIC_API_URL=
# Extra browser origins, comma-separated, allowed to call the API.
CORS_ORIGINS=

# Primary Apify token.
APIFY_TOKEN=
# Second Apify account, used when the primary is out of credit.
APIFY_TOKEN_FALLBACK=
# Further Apify tokens, comma-separated.
APIFY_TOKENS=
# Per-search spend cap in USD. Defaults to 1.
DISCOVERY_RUN_BUDGET_USD=
# TikTok video actor. Defaults to clockworks/tiktok-scraper.
APIFY_TIKTOK_ACTOR=
# TikTok followers actor. Defaults to clockworks/tiktok-followers-scraper.
APIFY_FOLLOWERS_ACTOR=
# Instagram actor. Defaults to apify/instagram-scraper.
APIFY_INSTAGRAM_ACTOR=
# Set to 1 to scrape profiles again after a video search.
DISCOVERY_PROFILE_ENRICH=
# Optional legacy single-actor override.
APIFY_ACTOR_ID=

# API listen port. Defaults to 3001.
PORT=
# API bind address. Defaults to 0.0.0.0.
HOST=

# Optional inline email template. The admin editor is the usual path.
EMAIL_TEMPLATE=
# Optional path to an email template file.
EMAIL_TEMPLATE_PATH=

# n8n webhook base, if you run the optional n8n workflows.
N8N_WEBHOOK_BASE_URL=

# Postgres URL for npm run setup:db. Not read by the running app.
DATABASE_URL=

# Optional Netlify deploy token. Not required to run locally.
NETLIFY_AUTH_TOKEN=
# Optional Netlify site id.
NETLIFY_SITE_ID=

# Set by Railway. Used as the public API host when PUBLIC_API_URL is empty.
RAILWAY_PUBLIC_DOMAIN=
# Set by Railway. Skips the admin npm install during the API image build.
RAILWAY_ENVIRONMENT=
# Set to 1 to skip installing admin dependencies.
SOLIS_SKIP_ADMIN_INSTALL=
