# Supabase project URL baked into the admin. Required before sign-in.
VITE_SUPABASE_URL=
# Supabase anon key. Never put the service role key here.
VITE_SUPABASE_ANON_KEY=
# Express API origin. Use http://localhost:3001 for local development.
VITE_EXPRESS_API_URL=
# Same API origin. Kept for older builds that read this name.
VITE_API_BASE_URL=
# Optional product name shown before an app is selected.
VITE_APP_NAME=
# Optional one-line pitch.
VITE_APP_VALUE_PROP=
# Optional. Prefer Connectors so the webhook is not baked into the admin bundle.
VITE_DISCORD_WEBHOOK_URL=
# Optional email prefilled on the login form.
VITE_ADMIN_EMAIL=
