{
  "name": "creator-outreach-engine",
  "version": "1.0.0",
  "description": "In-house automated creator outreach engine (Supabase + n8n + cold email)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "postinstall": "node scripts/install-admin.mjs",
    "dev": "concurrently -n api,admin -c blue,magenta \"npm run server\" \"npm run dev --prefix admin\"",
    "dev:api": "npm run server",
    "dev:admin": "npm run dev --prefix admin",
    "start": "npm run server",
    "test": "vitest run",
    "test:groq": "tsx scripts/test-groq-hook.ts",
    "build": "tsc && node scripts/bundle-netlify-discovery.mjs && npm run build --prefix admin",
    "build:api": "tsc --pretty false",
    "typecheck": "tsc --noEmit && npm exec --prefix admin -- tsc -b --pretty false",
    "server": "tsx server/index.ts",
    "e2e:demo": "tsx scripts/e2e-demo-campaign.ts",
    "sync:admin-env": "node scripts/sync-env.mjs",
    "install:admin": "npm install --prefix admin",
    "sync:env": "node scripts/sync-env.mjs",
    "setup:db": "node scripts/setup-db.mjs",
    "build:admin": "npm run build --prefix admin",
    "deploy:netlify": "netlify-cli deploy --prod"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "cors": "^2.8.5",
    "cron-parser": "^5.10.1",
    "express": "^4.21.0",
    "node-cron": "^4.6.0",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^9.2.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "netlify-cli": "^17.36.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "private": true
}
